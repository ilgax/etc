{
  "name": "Pix2Text-MFR 1.5 (int8)",
  "encoder": "encoder_model.onnx",
  "decoder": "decoder_model.onnx",
  "tokenizer": "tokenizer.json",
  "input": {
    "width": 384,
    "height": 384,
    "channels": 3,
    "resize": "stretch",
    "padColor": 255,
    "mean": [0.5, 0.5, 0.5],
    "std": [0.5, 0.5, 0.5]
  },
  "bos": 1,
  "eos": 2,
  "pad": 0,
  "maxTokens": 256,
  "decoderCache": "none",
  "postprocess": {
    "joinSpacedTokens": true,
    "stripWrappers": ["\\[", "\\]"]
  }
}
